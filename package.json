{
  "name": "space-invaders",
  "version": "0.1.0",
  "private": true,
  "description": "Local-only Space Invaders clone built with TypeScript + HTML5 Canvas, developed with TDD on Vite+",
  "type": "module",
  "scripts": {
    "prepare": "lefthook install || true",
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "test": "vp test run",
    "test:watch": "vp test watch",
    "test:cov": "vp test run --coverage",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "fmt": "vp fmt --check",
    "fmt:write": "vp fmt --write .",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:all": "vp test run && playwright test",
    "gate": "vp fmt --check && vp lint && tsc --noEmit && vp test run && vp build",
    "secrets:scan": "gitleaks detect --no-banner --redact --source ."
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@vitest/coverage-v8": "5.0.3",
    "jsdom": "^29.1.1",
    "lefthook": "^2.1.6",
    "typescript": "^6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0",
    "vite-plus": "1.1.0",
    "vitest": "5.0.3"
  },
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "overrides": {
      "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0",
      "vitest": "5.0.3",
      "esbuild": ">=0.28.1",
      "undici": "^7.29.1",
      "tinypool": "^2.1.2",
      "postcss": ">=8.5.23"
    }
  }
}
